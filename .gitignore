# Typings that Claude Code writes when it loads each plugin
plugins/*/.claude-plugin/types/

# State and socket of the codex-computer-use helper, if it runs straight from the folder
plugins/codex-computer-use/helper/state/
plugins/codex-computer-use/helper/run/

# Saved `claude plugin validate --strict` output (npm run plugins:scan)
.scan*/

# Local review and test reports
.reports/

# Local state of the superpowers skills (brainstorm server, sdd)
.superpowers/

# Development tools installed by npm ci
node_modules/

# Local Claude Code state a session may create in the checkout
.claude/worktrees/
.claude/settings.local.json
